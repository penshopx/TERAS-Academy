{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "preinstall": "sh -c 'rm -f package-lock.json yarn.lock; case \"$npm_config_user_agent\" in pnpm/*) ;; *) echo \"Use pnpm instead\" >&2; exit 1 ;; esac'",
    "build": "pnpm run typecheck && pnpm -r --if-present run build",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm --filter @workspace/api-spec run test && pnpm --filter @workspace/api-spec run validate && pnpm run typecheck:libs && pnpm -r --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run typecheck",
    "setup:browser-idempotency": "pnpm --filter @workspace/api-server run setup:browser-idempotency",
    "setup:browser-admin-access": "pnpm --filter @workspace/api-server run setup:browser-admin-access",
    "test:browser-idempotency": "pnpm --filter @workspace/api-server run test:browser-idempotency",
    "test:certification-preparation-release-workflow": "pnpm --filter @workspace/scripts run test:certification-preparation-release-workflow",
    "test:app-storage-sidecar-smoke-contract": "pnpm --filter @workspace/scripts run test:app-storage-sidecar-smoke-contract",
    "smoke:app-storage": "pnpm --filter @workspace/api-server run smoke:app-storage",
    "gate:certification-preparation": "pnpm --filter @workspace/scripts run gate:certification-preparation"
  },
  "private": true,
  "dependencies": {
    "@replit/connectors-sdk": "^0.4.1"
  },
  "devDependencies": {
    "prettier": "^3.9.6",
    "typescript": "~5.9.3"
  }
}
