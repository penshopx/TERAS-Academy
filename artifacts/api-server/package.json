{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "export NODE_ENV=development && pnpm run build && pnpm run start",
    "build": "node ./build.mjs",
    "start": "node --enable-source-maps ./dist/index.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:pathway-isolation": "NODE_ENV=test tsx ./src/pathway-isolation.integration.ts",
    "test:safety-blockers": "NODE_ENV=test tsx ./src/safety-blockers.integration.ts",
    "test:learning-transition": "NODE_ENV=test tsx ./src/learning-transition.integration.ts",
    "test:course-authoring:contract": "NODE_ENV=test tsx ./src/course-authoring.contract.test.ts",
    "test:course-authoring": "pnpm run test:course-authoring:contract && bash ../../scripts/course-authoring.integration.test.sh",
    "test:identity-isolation": "NODE_ENV=test tsx ./src/identity-isolation.integration.ts",
    "test:learner-isolation": "NODE_ENV=test tsx ./src/learner-isolation.integration.ts",
    "test:readiness-dashboard-isolation": "NODE_ENV=test tsx ./src/readiness-dashboard-isolation.integration.ts",
    "test:admin-authorization": "NODE_ENV=test tsx ./src/admin-authorization.integration.ts",
    "test:admin-membership-write-guard": "tsx ./src/admin-membership-write-guard.test.ts",
    "test:admin-management": "pnpm run test:admin-membership-write-guard && NODE_ENV=test tsx ./src/admin-management.integration.ts",
    "test:admin-operational-summary": "NODE_ENV=test tsx ./src/admin-operational-summary.integration.ts",
    "test:resource-uri": "NODE_ENV=test tsx ./src/lib/resource-uri.test.ts",
    "test:learning-resume": "NODE_ENV=test tsx --test ./src/lib/learning-resume.test.ts",
    "test:knowledge-safety": "NODE_ENV=test tsx ./src/lib/knowledge-safety.test.ts",
    "test:knowledge-lifecycle": "NODE_ENV=test tsx ./src/knowledge-lifecycle.integration.ts",
    "test:trainer-bottlenecks": "NODE_ENV=test tsx --test ./src/lib/trainer-bottlenecks.test.ts",
    "test:browser-idempotency-guard": "tsx ./src/browser-idempotency-guard.test.ts",
    "test:browser-idempotency-workflow-contract": "tsx ./src/browser-idempotency-workflow-contract.test.ts",
    "setup:browser-idempotency": "playwright install --with-deps chromium",
    "test:browser-idempotency": "NODE_ENV=test tsx ./src/browser-idempotency.integration.ts",
    "test:certification-preparation-journey": "NODE_ENV=test tsx ./src/certification-preparation-journey.integration.ts",
    "test:app-storage-sidecar": "NODE_ENV=test tsx ./src/app-storage-sidecar.integration.ts",
    "smoke:app-storage": "bash ../../scripts/app-storage-sidecar-smoke.sh"
  },
  "dependencies": {
    "@clerk/express": "^2.1.65",
    "@clerk/shared": "^4.30.2",
    "@google-cloud/storage": "^8.0.1",
    "@workspace/api-zod": "workspace:*",
    "@workspace/db": "workspace:*",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "drizzle-orm": "catalog:",
    "express": "^5.2.1",
    "google-auth-library": "^11.0.2",
    "http-proxy-middleware": "^4.2.0",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "catalog:",
    "@types/pg": "^8.20.0",
    "esbuild": "0.27.3",
    "esbuild-plugin-pino": "^2.3.3",
    "pg": "^8.22.0",
    "pino-pretty": "^13.1.3",
    "playwright": "^1.62.1",
    "thread-stream": "3.1.0",
    "tsx": "catalog:"
  }
}
