modules = ["nodejs-24", "python-base-3.13", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[[deployment.scheduled]]
name = "App Storage weekday smoke"
command = "pnpm run smoke:app-storage"
schedule = "0 16 * * 1-5"
timeout = 180

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 180000

[nix]
channel = "stable-25_05"
packages = ["freetype", "gumbo", "harfbuzz", "jbig2dec", "libjpeg_turbo", "mupdf", "openjpeg", "swig", "xcbuild"]

[userenv]

[userenv.production]
TERAS_BOOTSTRAP_ADMIN_CLERK_USER_ID = "user_3Iu7i3J2jbRM4ckcFWzGLl1gFgu"
TERAS_BOOTSTRAP_SUPER_ADMIN_EMAIL = "penshopx@gmail.com"
